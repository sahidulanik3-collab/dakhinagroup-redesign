# Base public URL for Vite assets (e.g. /dakhina-group-website/ for GitHub Pages or / for custom domain)
VITE_BASE=/

# Toggle variant switcher bar (true for client preview mode, false for final production)
VITE_SHOW_SWITCHER=true

# Optional secure backend endpoint for inquiries, callbacks, and visit schedules
# If left blank, inquiries seamlessly fall back to WhatsApp prefilled chat or direct mailto
VITE_FORM_ENDPOINT=

# WhatsApp contact phone number (international format without + or spaces)
VITE_WHATSAPP_NUMBER=8801407048190

# Official contact email
VITE_CONTACT_EMAIL=info@dakhinagroup.com
